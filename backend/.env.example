# Copy this file to backend/.env (git-ignored) and fill in your values, then run: npm run deploy:api
# The access token is secret: keep it only in backend/.env, never in config.js, git, or chat.

# Square Developer Console > your app > Credentials (Sandbox toggle) > Access token. Starts with EAAA.
SQUARE_ACCESS_TOKEN=

# Square Developer Console > your app > Locations (sandbox). Public; also set in site/js/config.js.
SQUARE_LOCATION_ID=LVD23T0RKJF05

# sandbox while testing, production when going live (switch config.js squareEnv and squareAppId too).
SQUARE_ENV=sandbox

# Flat shipping charge in cents for shipped orders (0 = free). Must match shippingCents in site/js/config.js.
SHIPPING_CENTS=0

# Optional: Square customer group id that website email signups are added to. Leave empty to skip.
NEWSLETTER_GROUP_ID=

# Optional: max concurrent API runs (abuse cap). Use 0 if the AWS account can't reserve concurrency.
API_CONCURRENCY=5
