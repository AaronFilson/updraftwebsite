# Copy this file to backend/.env (git-ignored) and paste your Square SANDBOX access token.
# Used by local scripts targeting staging (npm run put-token -- --stage staging, load-items, load-test).
# Production scripts never read this file; they ask for the production token with hidden terminal input.
# Stage settings (location ID, app ID, newsletter group, concurrency) live in deploy/stages.json.

# Square Developer Console > your app > Credentials (Sandbox) > Access token. Starts with EAAA.
SQUARE_ACCESS_TOKEN=
