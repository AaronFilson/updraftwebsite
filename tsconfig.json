{
  // Type-checks the JavaScript as it is (no build step): JSDoc and inference only.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["backend/src/**/*.mjs", "scripts/**/*.mjs", "site/js/**/*.js", "site/js/**/*.d.ts"]
}
